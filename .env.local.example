# ─────────────────────────────────────────────────────────────────
# Copy this file and rename the copy to:  .env.local  (same folder)
#
# NOTE: The Gemini API key does NOT go here anymore — it lives only
# in the Vercel project (server/ folder) as a server-side env var,
# so it is never exposed in the public website bundle.
#
# The only thing needed here is the URL of your deployed micro-API:
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE="https://your-project-name.vercel.app"
